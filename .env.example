SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SYSTEM_NAME=Focus Lock Mode

# OPTION 1 (easiest, Supabase): Connect > Session pooler > copy the connection string.
# Replace [YOUR-PASSWORD] with your real password (letters/numbers only is safest).
# DATABASE_URL=postgresql://postgres.PROJECTCODE:YOURPASSWORD@HOST:5432/postgres

# OPTION 2 (local PostgreSQL or separate Supabase values)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
# Use "require" for Supabase
DB_SSLMODE=prefer
